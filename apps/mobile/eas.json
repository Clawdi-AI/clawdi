{
	"cli": { "version": "24.8.0", "appVersionSource": "remote" },
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"environment": "development",
			"node": "24.21.0",
			"bun": "1.4.2"
		},
		"e2e": {
			"extends": "development",
			"env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
			"android": { "withoutCredentials": true }
		},
		"e2e-ios": {
			"extends": "e2e",
			"ios": { "simulator": true }
		},
		"preview": {
			"distribution": "internal",
			"android": { "buildType": "apk" },
			"channel": "preview",
			"environment": "preview",
			"node": "24.21.0",
			"bun": "1.4.2"
		},
		"production": {
			"distribution": "store",
			"autoIncrement": true,
			"channel": "production",
			"environment": "production",
			"node": "24.21.0",
			"bun": "1.4.2"
		}
	},
	"submit": {
		"production": {
			"ios": {},
			"android": { "track": "internal" }
		}
	}
}
