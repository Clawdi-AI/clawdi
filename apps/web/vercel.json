{
	"framework": "tanstack-start",
	"installCommand": "bunx bun@1.4.2 install --frozen-lockfile",
	"ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && (git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA}^{commit}\" 2>/dev/null || git fetch --no-tags --depth=1 origin \"$VERCEL_GIT_PREVIOUS_SHA\") && turbo query affected --base=\"$VERCEL_GIT_PREVIOUS_SHA\" --packages web --exit-code",
	"rewrites": [
		{
			"source": "/_cdi/px/static/:path*",
			"destination": "https://us-assets.i.posthog.com/static/:path*"
		},
		{
			"source": "/_cdi/px/:path*",
			"destination": "https://us.i.posthog.com/:path*"
		}
	],
	"redirects": [
		{
			"source": "/install.sh",
			"destination": "https://raw.githubusercontent.com/Clawdi-AI/clawdi/main/install.sh",
			"permanent": false
		},
		{ "source": "/wallet", "destination": "/?settings=billing-wallet", "permanent": false },
		{ "source": "/subscription", "destination": "/?settings=billing-plan", "permanent": false },
		{ "source": "/pricing", "destination": "/?settings=billing-plan", "permanent": false },
		{
			"source": "/settings/billing/pricing",
			"destination": "/?settings=billing-plan",
			"permanent": false
		}
	]
}
