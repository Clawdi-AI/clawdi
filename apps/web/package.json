{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:oss": "VITE_CLAWDI_HOSTED=false VITE_CLERK_PUBLISHABLE_KEY=pk_test_dummy vite build",
		"start": "bun .output/server/index.mjs",
		"typecheck": "tsr generate && tsc --noEmit --incremental false",
		"lint": "biome ci --linter-enabled=true --formatter-enabled=false src",
		"test": "../../scripts/test.sh web",
		"test:internal": "bun test",
		"test:ssr:internal": "node --test --test-timeout=180000 scripts/production-ssr.mjs",
		"e2e": "playwright test",
		"e2e:hosted": "playwright test --config=playwright.hosted.config.ts",
		"icons": "bun scripts/brand-icons.ts",
		"generate-api": "../../scripts/openapi-typescript.sh http://localhost:8000/openapi.json -o ../../packages/shared/src/api/api.generated.ts",
		"generate-deploy-api": "../../scripts/generate-deploy-api.sh",
		"generate-deploy-api:live": "DEPLOY_OPENAPI_SOURCE=https://api.clawdi.ai/openapi.json ../../scripts/generate-deploy-api.sh"
	},
