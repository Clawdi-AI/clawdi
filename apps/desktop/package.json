{
	"name": "@clawdi/desktop",
	"version": "0.1.0",
	"description": "Clawdi desktop client",
	"author": "Clawdi",
	"homepage": "https://clawdi.ai",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"desktopName": "clawdi-desktop.desktop",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "bun run scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"test": "../../scripts/test.sh desktop",
		"test:internal": "bun test src",
		"prepare:native": "bun run scripts/prepare-native.ts",
		"package:preview": "bun run scripts/package-preview.ts",
		"package:release": "bun run scripts/package-release.ts"
	},
	"dependencies": {
		"builder-util-runtime": "9.7.0",
		"electron-updater": "6.8.9"
	},
	"devDependencies": {
		"@base-ui/react": "^1.8.0",
		"@clawdi/shared": "workspace:*",
		"@lobehub/icons": "catalog:",
		"@electron/fuses": "^2.1.3",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@playwright/test": "catalog:",
		"@tailwindcss/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"electron": "44.6.0",
		"electron-builder": "26.17.0",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "4.21.3",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"yaml": "catalog:"
	},
	"build": {
		"appId": "ai.clawdi.desktop",
		"productName": "Clawdi",
		"asar": true,
		"directories": {
			"buildResources": "build",
			"output": "release"
		},
		"afterPack": "apps/desktop/scripts/after-pack.mjs",
		"protocols": [
			{
				"name": "ai.clawdi.desktop",
				"schemes": [
					"clawdi-desktop"
				]
			}
		],
		"files": [
			"dist/**/*",
			"package.json"
		],
		"extraMetadata": {
			"clawdiUpdateChannel": "disabled"
		},
		"linux": {
			"syncDesktopName": true,
			"maintainer": "Clawdi <hello@clawdi.ai>",
			"artifactName": "Clawdi-${version}-${arch}.${ext}",
			"category": "Development",
			"executableName": "clawdi-desktop",
			"icon": "../web/public/clawdi-logo-transparent.png",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "deb",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "rpm",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"deb": {
			"packageName": "clawdi-desktop",
			"publish": null
		},
		"rpm": {
			"packageName": "clawdi-desktop",
			"publish": null
		},
		"extraResources": [
			{
				"from": "resources/native",
				"to": "native"
			},
			{
				"from": "../web/public/clawdi-logo-transparent.png",
				"to": "clawdi-logo.png"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"icon": "../web/public/clawdi-logo-transparent.png",
			"hardenedRuntime": true,
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64",
						"x64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"arm64",
						"x64"
					]
				}
			]
		},
		"win": {
			"icon": "../web/public/clawdi-logo-transparent.png",
			"extraResources": [
				{
					"from": "build/windows-cli-path.ps1",
					"to": "support/windows-cli-path.ps1"
				}
			],
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"artifactName": "Clawdi-${version}-win32-${arch}.${ext}",
			"verifyUpdateCodeSignature": true
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowElevation": false,
			"allowToChangeInstallationDirectory": true,
			"include": "build/installer.nsh",
			"deleteAppDataOnUninstall": false
		}
	}
}
