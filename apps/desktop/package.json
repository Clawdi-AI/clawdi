{
	"name": "@clawdi/desktop",
	"version": "0.1.0",
	"description": "Clawdi desktop client",
	"author": "Clawdi",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "bun build src/main.ts --outdir dist --target node --format esm --external electron && bun build src/preload.ts --outfile dist/preload.cjs --target node --format cjs --external electron",
		"typecheck": "tsc --noEmit",
		"prepare:native": "bun run scripts/prepare-native.ts",
		"package:mac": "bun run build && CLAWDI_NATIVE_TARGET=darwin-arm64 bun run prepare:native && electron-builder --mac dmg --arm64"
	},
	"dependencies": {
		"@clawdi/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"electron": "44.0.0",
		"electron-builder": "26.15.3",
		"tar": "^7.5.22",
		"typescript": "catalog:"
	},
	"build": {
		"appId": "ai.clawdi.desktop",
		"productName": "Clawdi",
		"asar": true,
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"extraMetadata": {
			"clawdiWebUrl": "https://cloud.clawdi.ai"
		},
		"extraResources": [
			{
				"from": "resources/native",
				"to": "native"
			},
			{
				"from": "../web/public/clawdi-logo-transparent.png",
				"to": "clawdi-logo.png"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"icon": "../web/public/clawdi-logo-transparent.png",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64"
					]
				}
			]
		}
	}
}
