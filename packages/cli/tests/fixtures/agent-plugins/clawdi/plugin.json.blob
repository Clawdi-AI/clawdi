{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "clawdi",
  "version": "1.0.0",
  "description": "Clawdi Cloud memory, session, project, Vault metadata, and connected-service tools.",
  "author": {
    "name": "Clawdi"
  },
  "homepage": "https://cloud.clawdi.ai",
  "repository": "https://github.com/Clawdi-AI/store",
  "license": "MIT",
  "keywords": [
    "clawdi",
    "memory",
    "sessions",
    "connectors"
  ],
  "extensions": {
    "ai.clawdi": {
      "schemaVersion": 1,
      "display": {
        "name": "Clawdi",
        "category": "productivity",
        "languages": [
          "en"
        ]
      },
      "compatibility": {
        "runtimes": [
          "openclaw",
          "hermes"
        ]
      }
    }
  }
}
